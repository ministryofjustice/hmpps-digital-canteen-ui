REDIS_ENABLED=false
TOKEN_VERIFICATION_ENABLED=false

# Credentials for allowing prisoner access
LAUNCHPAD_API_CLIENT_ID=hmpps-typescript-template
LAUNCHPAD_API_CLIENT_SECRET=clientsecret

# Staff portal (http://staff.localhost:3000)
AUTH_CODE_CLIENT_ID=hmpps-typescript-template
AUTH_CODE_CLIENT_SECRET=clientsecret

# Credentials for API calls
CLIENT_CREDS_CLIENT_ID=hmpps-typescript-template-system
CLIENT_CREDS_CLIENT_SECRET=clientsecret

# Local audit queues (ElasticMQ). Uncomment to send audit events locally, see docs/AUDIT_LOCAL_TESTING.md
# AUDIT_ENABLED=true
# AUDIT_SQS_QUEUE_URL=http://localhost:9324/000000000000/hmpps-audit-queue
# AUDIT_PRISONER_SQS_QUEUE_URL=http://localhost:9324/000000000000/hmpps-prisoner-audit-queue
# AUDIT_SERVICE_NAME=hmpps-digital-canteen-ui
# AUDIT_SQS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
