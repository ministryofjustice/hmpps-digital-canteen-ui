{% extends "../partials/layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}


{% set homeLinkHref = launchpadHome %}
{% set pageTitle = userName + "'s Canteen" %}

{% set vapeLineItemId = "" %}
{% set vapeQuantity = 0 %}
{% set cheeseLineItemId = "" %}
{% set cheeseQuantity = 0 %}
{% for item in basketDetails.items %}
    {% if item.variantId == "variant_01M6NNAC4FXFBZ39R2JGXT9MRS" %}
        {% set vapeLineItemId = item.lineItemId %}
        {% set vapeQuantity = item.quantity %}
    {% endif %}
    {% if item.variantId == "variant_01M6NN82NBN7DXBBTX4ZESGPBR" %}
        {% set cheeseLineItemId = item.lineItemId %}
        {% set cheeseQuantity = item.quantity %}
    {% endif %}
{% endfor %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  {% call govukPanel({
    titleText: "Current basket"
  }) %}
    <strong>cartID: {{ basketDetails.cartId }}</strong><br>
    <strong>Total items: {{ basketDetails.itemCount }}</strong><br>
    <strong>Total item value: {{ basketDetails.allItemsTotal }}</strong><br>
    <br>
    {% for item in basketDetails.items %}
      <div>
        Item name: {{ item.title }}: with number of: {{ item.quantity }} <br>
        item price: {{ item.unitPrice }}
        <br>
        <small>lineItemId: {{ item.lineItemId }}</small>
      </div>
      <br>
    {% endfor %}
    {% if basketDetails.items.length == 0 %}
      <strong>Basket is empty</strong>
    {% endif %}
  {% endcall %}

  <div class="app-card-group govuk-!-margin-bottom-6 govuk-!-margin-top-0 govuk-!-padding-top-0">

    <form method="post" action="/api/add-line-item">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="productVariantId" value="variant_01M6H0PRQ9ZQ2XGR2A1B1HG043">
      <button type="submit" class="app-card app-card--green app-card--button">
        <div class="app-card__header">
          <svg class="app-card__icon" viewBox="1 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3 10a1 1 0 0 1 1-1h6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm10 5a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v6h-8zm2-6h4v3h-4zM6 4h4v5H6zm2 0V2m9 7V6m0 11v-5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" fill="white"/>
          </svg>
        </div>
        <div class="app-card__body">
          <h2 class="app-card__title">
            <span class="app-card__link">Buy vape</span>
          </h2>
          <p class="govuk-body app-card__description">Add item to canteen basket.</p>
        </div>
      </button>
    </form>

    <form method="post" action="/api/add-line-item">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="productVariantId" value="variant_01M6H0QDAZ17DAJB1S7KA1RM5V">
      <button type="submit" class="app-card app-card--green app-card--button">
          <div class="app-card__header">
              <svg class="app-card__icon" viewBox="0 0 32 32" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M11.188 11.887c0.217 0.304 0.34 0.676 0.34 1.095 0 1.326-1.234 2.623-2.757 2.897s-2.757-0.58-2.757-1.906c0-0.261 0.049-0.521 0.137-0.773l-5.492 1.432v7.235c0.243-0.116 0.484-0.248 0.748-0.308 1.544-0.355 2.796 0.471 2.796 1.817s-1.253 2.731-2.796 3.086c-0.262 0.060-0.508 0.072-0.748 0.069v2.092l13.516-3.524c-0.355-0.471-0.562-1.035-0.562-1.64 0-1.654 1.54-2.996 3.441-2.996 1.863 0 3.38 1.29 3.438 2.9 0.058 0.016 0.115 0.031 0.173 0.047l10.515-2.709v-14.024l-19.993 5.211zM24.767 19.393c-1.017 0-1.841-0.718-1.841-1.604s0.824-1.604 1.841-1.604 1.841 0.718 1.841 1.604-0.824 1.604-1.841 1.604zM14.346 2.832l-1.022 0.863c1.243 0.64 1.46 1.937 0.481 2.904-0.982 0.97-2.796 1.24-4.052 0.603-0.124-0.063-0.237-0.132-0.34-0.207l-8.368 7.062 28.673-7.525c-3.207-2.792-9.45-4.136-15.372-3.699zM29.718 6.531v0 0z"></path>
              </svg>
          </div>
          <div class="app-card__body">
              <h2 class="app-card__title">
                  <span class="app-card__link">Buy cheese</span>
              </h2>
              <p class="govuk-body app-card__description">Add item to canteen basket.</p>
          </div>
      </button>
    </form>

    <form method="post" action="/api/remove-line-item">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="productVariantId" value="variant_01M6E4F0KWV67V7JV3TN7DMAM7">
      <input type="hidden" name="lineItemId" value="{{ vapeLineItemId }}">
      <input type="hidden" name="quantity" value="{{ vapeQuantity }}">
      <button type="submit" class="app-card app-card--green app-card--button">
        <div class="app-card__header">
          <svg class="app-card__icon" viewBox="1 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3 10a1 1 0 0 1 1-1h6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm10 5a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v6h-8zm2-6h4v3h-4zM6 4h4v5H6zm2 0V2m9 7V6m0 11v-5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" fill="white"/>
          </svg>
        </div>
        <div class="app-card__body">
          <h2 class="app-card__title">
            <span class="app-card__link">Remove Item: vape</span>
          </h2>
          <p class="govuk-body app-card__description">Remove vape Canteen basket.</p>
        </div>
      </button>
    </form>

    <form method="post" action="/api/remove-line-item">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="productVariantId" value="variant_01M6E4F0KWV67V7JV3TN7DMAM7">
      <input type="hidden" name="lineItemId" value="{{ cheeseLineItemId }}">
      <input type="hidden" name="quantity" value="{{ cheeseQuantity }}">
      <button type="submit" class="app-card app-card--green app-card--button">
        <div class="app-card__header">
          <svg class="app-card__icon" viewBox="1 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3 10a1 1 0 0 1 1-1h6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm10 5a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v6h-8zm2-6h4v3h-4zM6 4h4v5H6zm2 0V2m9 7V6m0 11v-5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" fill="white"/>
          </svg>
        </div>
        <div class="app-card__body">
          <h2 class="app-card__title">
            <span class="app-card__link">Remove Item: cheese</span>
          </h2>
          <p class="govuk-body app-card__description">Remove cheese Canteen basket.</p>
        </div>
      </button>
    </form>

    <form method="post" action="/api/remove-basket">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="productVariantId" value="variant_01M6E4F0KWV67V7JV3TN7DMAM7">
      <button type="submit" class="app-card app-card--green app-card--button">
        <div class="app-card__header">
          <svg class="app-card__icon" viewBox="1 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3 10a1 1 0 0 1 1-1h6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm10 5a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v6h-8zm2-6h4v3h-4zM6 4h4v5H6zm2 0V2m9 7V6m0 11v-5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" fill="white"/>
          </svg>
        </div>
        <div class="app-card__body">
          <h2 class="app-card__title">
            <span class="app-card__link">Remove/Cancel basket</span>
          </h2>
          <p class="govuk-body app-card__description">Remove Basket :c</p>
        </div>
      </button>
    </form>
  </div>
{% endblock %}
