{% extends "../partials/layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}



{% set homeLinkHref = launchpadHome %}
{% set pageTitle = userName + "'s Canteen" %}

{% set vapeLineItemId = "" %}
{% set vapeQuantity = 0 %}
{% set cheeseLineItemId = "" %}
{% set cheeseQuantity = 0 %}
{% for item in basketDetails.items %}
    {% if item.variantId == "variant_01M70B35K777A46J5ZA5TX19PF" %}
        {% set vapeLineItemId = item.lineItemId %}
        {% set vapeQuantity = item.quantity %}
    {% endif %}
    {% if item.variantId == "variant_01M70B2Q6XY0E69FSPS3B79MX2" %}
        {% set cheeseLineItemId = item.lineItemId %}
        {% set cheeseQuantity = item.quantity %}
    {% endif %}
{% endfor %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>


{% if draftOrderDetails.hasDraftOrder %}
  {% call govukPanel({
    titleText: "Current order"
  }) %}
    <br>
    {% for item in draftOrderDetails.items %}
      <div>
        {{ item.title }}<br>
        Quantity: {{ item.quantity }}<br>
        Item price: £{{ item.unitPrice.toFixed(2) }}<br>
        Item total: £{{ item.lineTotal.toFixed(2) }}<br>
      </div>
      <br>
    {% else %}
      <strong>Order is empty</strong>
    {% endfor %}
    Total item count: {{ draftOrderDetails.itemCount }}<br>
    Overall total price: £{{ draftOrderDetails.total.toFixed(2) }}<br>
  {% endcall %}

  <div class="app-card-group govuk-!-margin-bottom-6 govuk-!-margin-top-0 govuk-!-padding-top-0">

    <form method="post" action="/api/cancel-draft-order">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="app-card app-card--green app-card--button">
        <div class="app-card__header">
          <svg class="app-card__icon" viewBox="1 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3 10a1 1 0 0 1 1-1h6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm10 5a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v6h-8zm2-6h4v3h-4zM6 4h4v5H6zm2 0V2m9 7V6m0 11v-5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" fill="white"/>
          </svg>
        </div>
        <div class="app-card__body">
          <h2 class="app-card__title">
            <span class="app-card__link">Cancel order</span>
          </h2>
          <p class="govuk-body app-card__description">Cancel order</p>
        </div>
      </button>
    </form>

  </div>

{% else %}
    <p class="govuk-body govuk-!-font-weight-bold">You have no orders at the moment.</p>
{% endif %}


{% endblock %}
