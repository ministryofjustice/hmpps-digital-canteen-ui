{% extends "../partials/layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{%- from "moj/components/sub-navigation/macro.njk" import mojSubNavigation -%}
{%- from "moj/components/search/macro.njk" import mojSearch -%}
{%- from "moj/components/side-navigation/macro.njk" import mojSideNavigation -%}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "../components/product-card.njk" import productCard %}

{% set homeLinkHref = launchpadHome %}
{% set pageTitle = userName + "'s Canteen" %}


{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>


{{ mojSubNavigation({
  label: "Sub navigation",
  items: [{
    html: "<strong>Shop Canteen</strong>",
    href: "#1",
    active: true
  }, {
    html: "<strong>Current order</strong>",
    href: "#2"
  }, {
    html: "<strong>Previous orders</strong>",
    href: "#3"
  }]
}) }}

<div class="order-summary">
  <div class="summary-card">
    <span class="summary-label">Canteen spends balance</span>
    <span class="summary-value">£{{ spendBalance | default('0.00') }}</span>
  </div>

  <div class="summary-card summary-card--primary">
    <div class="summary-icon">
      <svg class="icon-basket" fill="none" width="800px" height="800px" viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#ffffff" stroke-width="1.5" stroke-linecap="straight" stroke-linejoin="round">
        <path d="M3 9h24l-3 18H6L3 9z"/>
        <path d="M2 9h26"/>
        <path d="M10 14v9m5-9v9m5-9v9"/>
        <path d="M8 9l7-8 7 8"/></g>
      </svg>
    </div>
    <div>
      <span class="summary-label">
        Basket total ({{ basket.itemCount }} items)
      </span>
      <span class="summary-value">
        £ {{ basket.total | default('0.00') }}
      </span>
    </div>
  </div>

  <div class="summary-card">
    <span class="summary-label">Canteen closes on</span>
    <span class="summary-value summary-value--small">
      Friday 15 Dec at 5pm
    </span>
  </div>

  <div class="summary-card">
    <span class="summary-label">You have</span>
    <span class="summary-value summary-value--small">
      {{ hoursRemaining }} hours left to order
    </span>
  </div>
</div>
<div class="govuk-grid-row">
<div class="govuk-grid-column-one-half">
  {{ mojSearch({
    action: "#",
    input: {
      id: "search",
      name: "search"
    },
    label: {
      text: "Search for products",
      classes: "moj-search__label"
    },
    hint: {
      text: "You can search by name or description"
    },
    button: {
      text: "Search"
    }
  }) }}
  </div>
  </div>

{% if productCatalogueUnavailable %}
<div class="govuk-grid-row app-product-catalogue" data-qa="product-catalogue-unavailable">
  <div class="govuk-grid-column-two-thirds">
    <h2 class="govuk-heading-m">Products can't be shown at the moment</h2>
    <p class="govuk-body">Try again later.</p>
  </div>
</div>
{% else %}
<div class="govuk-grid-row app-product-catalogue" data-qa="product-catalogue">
  <div class="govuk-grid-column-one-quarter">
    {{ mojSideNavigation({
      label: "Product categories",
      classes: "app-category-navigation",
      sections: [{
        heading: {
          text: "Categories",
          headingLevel: 2,
          classes: "govuk-visually-hidden"
        },
        items: productCatalogue.categoryNavigation
      }]
    }) }}
  </div>

  <div class="govuk-grid-column-three-quarters">
    <section class="app-product-catalogue__products" aria-labelledby="products-heading">
      <h2 class="govuk-heading-l" id="products-heading">{{ productCatalogue.heading }} ({{ productCatalogue.totalCount }})</h2>

      {% if productCatalogue.products | length %}
        <ul class="app-product-grid">
          {% for product in productCatalogue.products %}
            {{ productCard(product) }}
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body">There are no products to show.</p>
      {% endif %}

      {% if pagination %}
        {{ govukPagination({
          items: pagination.items,
          previous: pagination.previous,
          next: pagination.next,
          landmarkLabel: "Product results"
        }) }}
      {% endif %}
    </section>
  </div>
</div>
{% endif %}
{% endblock %}
